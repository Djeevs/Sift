{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run test:watch)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npx vitest run *)",
      "Bash(npx vitest run)",
      "Bash(npm run funnel *)",
      "Bash(npm run funnel)",
      "Bash(npm run bands *)",
      "Bash(npm run bands)",
      "Bash(npm run budget *)",
      "Bash(npm run budget)",
      "Bash(npm run stats *)",
      "Bash(npm run stats)",
      "Bash(npm run inspect *)",
      "Bash(npm run replay *)",
      "Bash(npm run replay)",
      "Bash(npm run cluster:stats)",
      "Bash(npm run cluster:eval *)",
      "Bash(npm run cluster:eval)",
      "Bash(npm run doctor *)",
      "Bash(npm run doctor)",
      "Bash(npm run check-sources *)",
      "Bash(npm run check-sources)",
      "Bash(npm run share-check)",
      "Bash(node --env-file=.env node_modules/.bin/tsx src/cli/budget.ts *)",
      "Bash(node --env-file=.env node_modules/.bin/tsx src/cli/funnel.ts *)",
      "Bash(node --env-file=.env node_modules/.bin/tsx src/cli/bands.ts *)",
      "Bash(node --env-file=.env node_modules/.bin/tsx src/cli/stats.ts *)",
      "Bash(node --env-file=.env node_modules/.bin/tsx src/cli/inspect.ts *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(sed -n *)",
      "Bash(jq *)",
      "Bash(diff *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(awk *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./worker/.dev.vars)",
      "Read(./worker/wrangler.toml)",
      "Read(./data/**)",
      "Read(./profiles/dimaz/**)",
      "Read(./profiles/temp/**)"
    ]
  }
}
