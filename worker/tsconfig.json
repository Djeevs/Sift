{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  // worker-configuration.d.ts is generated by `wrangler types` from the
  // bindings in wrangler.toml. Rerun it after changing those.
  "include": ["src/**/*.ts", "worker-configuration.d.ts"]
}
