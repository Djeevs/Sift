{
  "name": "sift",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A private, AI-assisted editorial desk for the internet. Reeder is the frontend.",
  "license": "MIT",
  "files": [
    ".github/workflows/ci.yml",
    ".env.example",
    "config/",
    "docs/",
    "onboarding/",
    "profiles/example/",
    "prompts/",
    "src/",
    "tests/",
    "worker/package.json",
    "worker/package-lock.json",
    "worker/schema.sql",
    "worker/src/",
    "worker/tsconfig.json",
    "worker/wrangler.example.toml",
    "CLAUDE.md",
    "README.md",
    "LICENSE",
    "mac/",
    "npm-shrinkwrap.json",
    "tsconfig.json",
    "vitest.config.ts"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "audit": "tsx src/cli/audit.ts",
    "bands": "tsx src/cli/bands.ts",
    "budget": "tsx src/cli/budget.ts",
    "calibrate": "tsx src/cli/calibrate.ts",
    "cluster:eval": "tsx src/cli/cluster-eval.ts",
    "cluster:pairs": "tsx src/cli/cluster-pairs.ts",
    "cluster:stats": "tsx src/cli/cluster-stats.ts",
    "build": "tsc -p tsconfig.json && cp src/db/schema.sql dist/db/schema.sql",
    "app:build": "tsx src/cli/app-build.ts",
    "check-sources": "tsx src/cli/check-sources.ts",
    "cycle": "npm run pipeline && npm run push && npm run pull",
    "db:reset": "tsx src/cli/db-setup.ts --reset",
    "db:setup": "tsx src/cli/db-setup.ts",
    "dev": "tsx watch src/cli/serve-and-schedule.ts",
    "doctor": "tsx src/cli/doctor.ts --no-sync",
    "export": "tsx src/cli/export-static.ts",
    "feedback": "tsx src/cli/feedback.ts",
    "funnel": "tsx src/cli/funnel.ts",
    "home": "tsx src/cli/home.ts",
    "ingest": "tsx src/cli/ingest.ts",
    "inspect": "tsx src/cli/inspect.ts",
    "learn": "tsx src/cli/learn.ts",
    "onboard": "tsx src/cli/onboard.ts",
    "pipeline": "tsx src/cli/pipeline.ts",
    "replay": "tsx src/cli/replay.ts",
    "reader:delete": "tsx src/cli/reader-delete.ts",
    "review": "tsx src/cli/review.ts",
    "process": "tsx src/cli/process.ts",
    "publish": "tsx src/cli/publish.ts",
    "pull": "tsx src/cli/pull.ts",
    "push": "tsx src/cli/push.ts",
    "cloud:setup": "tsx src/cli/cloud-setup.ts",
    "kv:retire": "tsx src/cli/kv-retire-feed.ts",
    "serve": "tsx src/cli/serve-and-schedule.ts",
    "service:install": "tsx src/cli/service.ts install",
    "service:uninstall": "tsx src/cli/service.ts uninstall",
    "service:start": "tsx src/cli/service.ts start",
    "service:stop": "tsx src/cli/service.ts stop",
    "service:restart": "tsx src/cli/service.ts restart",
    "service:status": "tsx src/cli/service.ts status",
    "share-check": "node --import tsx src/cli/share-check.ts",
    "share-package": "npm run share-check && npm pack --cache /tmp/sift-share-npm-cache",
    "sources:discover": "tsx src/cli/source-discover.ts",
    "sources:suggest": "tsx src/cli/source-suggest.ts",
    "sources:adopt": "tsx src/cli/source-adopt.ts",
    "start": "node dist/cli/serve-and-schedule.js",
    "stats": "tsx src/cli/stats.ts",
    "ui": "tsx src/cli/ui.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "worker:deploy": "cd worker && npx wrangler deploy",
    "worker:tail": "cd worker && npx wrangler tail"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@mozilla/readability": "^0.5.0",
    "fast-xml-parser": "^4.5.1",
    "hono": "^4.6.14",
    "jsdom": "^25.0.1",
    "openai": "^4.77.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
