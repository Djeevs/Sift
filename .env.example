# ---------------------------------------------------------------------------
# Sift environment
# Copy to .env and fill in. A commercial API key is not required when using
# Ollama locally; `SIFT_DRY_RUN=1` also exercises the full plumbing for free.
# ---------------------------------------------------------------------------

# --- AI provider -----------------------------------------------------------
# Presets: openai, ollama, openrouter, groq, gemini, anthropic, custom.
# All use an OpenAI-compatible chat surface; Sift keeps provider details out of
# ranking code. Ollama needs no key. Anthropic compatibility is suitable for
# evaluation but its own documentation recommends the native API for production.
SIFT_AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Advanced/hybrid mode: choose a provider independently for each role. A role
# can also use SIFT_<ROLE>_BASE_URL and SIFT_<ROLE>_API_KEY for a custom endpoint.
# SIFT_TRIAGE_PROVIDER=ollama
# SIFT_DEEP_PROVIDER=openai
# SIFT_EMBEDDING_PROVIDER=ollama
# SIFT_TRIAGE_BASE_URL=http://127.0.0.1:11434/v1

# Model ids, reasoning effort and prices live in config/models.yaml
# under `models:` -- that is the place to change them.
#
# These override that config, for trying a model without editing a file.
# Leave them unset in normal use.
# SIFT_TRIAGE_MODEL=
# SIFT_DEEP_MODEL=
# SIFT_EMBEDDING_MODEL=

# Hard ceiling on model spend per pipeline run (USD). 0 = no limit.
SIFT_MAX_SPEND_PER_RUN=2.00

# --- Cloudflare edge (optional) ---------------------------------------------
# The edge Worker serves the feeds and records opens; `npm run push` uploads
# the generated feeds to it. See README "Deploying to Cloudflare".
# API token needs one permission: Account > Workers KV Storage > Edit.
# CLOUDFLARE_ACCOUNT_ID=
# # Optional. CLOUDFLARE_API_TOKEN is only needed if you would rather not rely on
# the wrangler login: when it is absent, `npm run push` uploads through the
# wrangler CLI using the same OAuth credentials that deployed the Worker.
CLOUDFLARE_API_TOKEN=
# SIFT_KV_NAMESPACE_ID=

# --- Storage ---------------------------------------------------------------
SIFT_DB_PATH=./data/sift.db
# An alternative config directory is an overlay on config/.
# SIFT_CONFIG_DIR=./profiles/alice
# Generated profiles can be selected on every command with `--profile alice`,
# or here. Their database defaults to data/profiles/alice.db.
# SIFT_PROFILE=alice

# --- Server ----------------------------------------------------------------
PORT=8787
# Local Mac control panel. It always binds to 127.0.0.1.
SIFT_UI_PORT=8790
# Public base URL of this service. Used to build tracked /open/<id> links and
# feed self-references. Must be reachable by Reeder.
SIFT_PUBLIC_URL=http://localhost:8787
# Token appended to feed + admin URLs so the endpoints are not world-readable.
# Generate with: openssl rand -hex 24
SIFT_ACCESS_TOKEN=change-me-please

# --- Fetching --------------------------------------------------------------
SIFT_USER_AGENT=SiftPersonalReader/0.1 (+personal RSS curation; contact: you@example.com)
SIFT_FETCH_CONCURRENCY=6
SIFT_HTTP_TIMEOUT_MS=20000
# Private, loopback and link-local fetch targets are blocked by default. Enable
# only when deliberately polling a trusted feed on your own LAN/localhost.
SIFT_ALLOW_PRIVATE_NETWORK=0

# --- Explicit feedback from Reeder -----------------------------------------
# Create a tag or shared feed in Reeder per signal and paste its URL here.
# Comma-separate to poll more than one per signal. See README.
# SIFT_FEEDBACK_EXCELLENT_URL=
# SIFT_FEEDBACK_NOT_FOR_ME_URL=

# --- Behaviour -------------------------------------------------------------
# Set to 1 to run the pipeline without making any model calls (uses stub scores).
# Useful for testing the plumbing end to end for free.
SIFT_DRY_RUN=0
SIFT_LOG_LEVEL=info
